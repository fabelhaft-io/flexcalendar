{
  "name": "flexcalendar/caldav",
  "description": "CalDAV service with internal delegated authentication",
  "type": "project",
  "license": "Apache-2.0",
  "require": {
    "php": "8.4.*",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-pdo_pgsql": "*",
    "sabre/dav": "4.7.1"
  },
  "config": {
    "platform": {
      "php": "8.4.0"
    },
    "platform-check": true,
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require-dev": {
    "friendsofphp/php-cs-fixer": "3.95.27",
    "phpstan/phpstan": "2.2.17",
    "phpunit/phpunit": "12.5.38"
  },
  "scripts": {
    "format:check": "php-cs-fixer fix --dry-run --using-cache=no --config=.php-cs-fixer.php",
    "lint": [
      "@php -l .php-cs-fixer.php",
      "find src public internal tests -name '*.php' -print0 | xargs -0 -n1 php -l"
    ],
    "typecheck": "phpstan analyse --no-progress --level=6 src public internal tests",
    "test": "phpunit --no-configuration --do-not-cache-result tests/Unit"
  },
  "autoload": {
    "psr-4": {
      "Calflex\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Calflex\\Tests\\": "tests/"
    }
  }
}
