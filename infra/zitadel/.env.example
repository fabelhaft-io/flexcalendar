# Staging/production: password-manager CLI supplies ZITADEL_ACCESS_TOKEN.
# It needs IAM_OWNER to configure instance policies, and must NOT be the UI PAT.
# Local compose uses the first-instance seed PAT from a volume instead.
ZITADEL_ACCESS_TOKEN=
CALFLEX_ZITADEL_ENVIRONMENT=staging
CALFLEX_OIDC_ISSUER=https://auth.staging.flexcalendar.de
CALFLEX_ZITADEL_BASE_URL=https://auth.staging.flexcalendar.de
# Optional extra CA for the local stack only; TLS verification stays enabled.
CALFLEX_ZITADEL_CA_PATH=
CALFLEX_SEED_PAT_PATH=/zitadel-bootstrap/seed.pat
CALFLEX_SEED_PASSWORD=
CALFLEX_TOKEN_USER=alice
# OpenTofu pg backend: this instance's Zitadel database, schema calflex_tofu.
# Supply from the secret-store CLI; URI-encode credentials and verify TLS outside local.
PG_CONN_STR=
# Optional ephemeral provider/cache metadata only, NOT durable state.
TF_DATA_DIR=/tmp/calflex-tofu/staging/.terraform
