# --- calendar-flex local stack: environment (E02-R03) ------------------------
#
# Every knob of `infra/dev/compose.yaml`, with the development default each one
# falls back to. `make dev` needs none of them: the compose file carries the
# same defaults, so the stack comes up on a bare checkout.
#
# Copy this file to `infra/dev/.env` to change one. `.env` is gitignored and
# must never hold a real secret: the values here are deliberately insecure
# development placeholders for a stack that listens on loopback only.
#
# Production configuration is a different file with different values (E08), and
# no value from here belongs there.

# --- URLs --------------------------------------------------------------------
# Hostname suffix for the stack. `*.localhost` resolves to loopback by
# definition (RFC 6761), so no /etc/hosts entry is needed.
CALFLEX_DEV_DOMAIN=localhost

# Published HTTPS port on the host. Rootless Podman cannot bind below 1024
# without a sysctl change, and the local stack changes no sysctls, so 8443 is
# the default. The container port stays 8443: only where the port is forwarded
# changes. CalDAV is then https://caldav.localhost:<port>/, the API
# https://api.localhost:<port>/, Zitadel https://auth.localhost:<port>/ and
# Mailpit https://mailpit.localhost:<port>/.
CALFLEX_HTTPS_PORT=8443

# --- Postgres ----------------------------------------------------------------
# One cluster holds every durable state (D-11). The `caldav` database is created
# from CALFLEX_POSTGRES_DB; the initdb script adds Zitadel's.
CALFLEX_POSTGRES_USER=caldav
CALFLEX_POSTGRES_PASSWORD=caldav
CALFLEX_POSTGRES_DB=caldav

# --- Zitadel (D-03) ----------------------------------------------------------
# Core and login UI ship as two containers of the same release (ADR 0004).
CALFLEX_ZITADEL_VERSION=v4.16.0

# Must be exactly 32 characters for a new deployment, and must not change once
# the database exists.
CALFLEX_ZITADEL_MASTERKEY=MasterkeyNeedsToHave32Characters

# The instance's first human user, with the IAM_OWNER role. `make dev`'s
# console login.
CALFLEX_ZITADEL_ADMIN_USER=calflex-admin
CALFLEX_ZITADEL_ADMIN_PASSWORD=Password1!

# Signs the login UI session cookie. At least 32 characters.
CALFLEX_ZITADEL_LOGIN_SESSION_SECRET=SessionCookieSecretNeedsAtLeast32Chars

# --- Development seed (E02-R03) ----------------------------------------------
# The password every seeded test user logs in with. The users themselves are
# data, not configuration: they live in `infra/dev/seed/users.json`.
CALFLEX_SEED_PASSWORD=Password1!
