      "kind": "positive",
      "op": "jcs_dumps",
      "purpose": "Members are sorted by UTF-16 code unit; `@` sorts before letters.",
      "spec": "§4.1"
    },
    {
      "expected": {
        "jcs": "{\"backslash\":\"a\\\\b\",\"controls\":\"\\b\\t\\n\\f\\r\\u0000\\u0001\\u001f\",\"emoji\":\"🙂\",\"german\":\"Grüße\",\"quote\":\"a\\\"b\",\"separators\":\"  \"}"
      },
      "id": "jcs-string-escapes",
      "inputs": {
        "object": {
          "backslash": "a\\b",
          "controls": "\b\t\n\f\r\u0000\u0001\u001f",
          "emoji": "🙂",
          "german": "Grüße",
          "quote": "a\"b",
          "separators": "  "
        }
      },
      "kind": "positive",
      "op": "jcs_dumps",
      "purpose": "Escapes are RFC 8785's: short forms for \\b\\t\\n\\f\\r, \\u00xx lowercase for the rest, raw UTF-8 for everything else.",
      "spec": "§4.1"
    },
