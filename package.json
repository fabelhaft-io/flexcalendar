{
  "name": "calendar-flex",
  "version": "0.0.0",
  "private": true,
  "description": "calendar-flex monorepo. TypeScript packages are pnpm workspaces (D-09); see pnpm-workspace.yaml.",
  "engines": {
    "node": ">=24.17.0 <25",
    "pnpm": ">=12.9.1 <13"
  },
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.17.0",
      "onFail": "error"
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  },
  "scripts": {
    "format:check": "prettier --check package.json eslint.config.mjs .prettierrc.json \"infra/scripts/**/*.mjs\" infra/scripts/invariant-dependencies.json \"infra/scripts/fixtures/*.json\" \"infra/scripts/verify/invariants/*.json\"",
    "lint": "eslint infra/scripts eslint.config.mjs",
    "typecheck": "tsc --noEmit --types node --allowJs --checkJs --module nodenext --target es2023 infra/scripts/verify.mjs infra/scripts/verify.test.mjs infra/scripts/invariants.mjs infra/scripts/invariants.test.mjs",
    "test": "node --test infra/scripts/*.test.mjs"
  }
}
