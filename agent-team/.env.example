# Model for each dev-team role, as a Mastra model-router id ("<provider>/<model-id>").
# This is the one setup-wide switch for both harness and LLM: change these three lines
# (or just AGENT_MODEL, which each role falls back to) to move the whole team between
# Claude / GPT / DeepSeek without touching any agent code. No defaults are baked in —
# config.ts fails fast if a role's model isn't set, same convention as server/.env.
#
# Only Claude is exercised for real today; the OpenAI/DeepSeek rows are here so adding
# a key is the only step needed later, not a code change.
AGENT_MODEL=anthropic/claude-sonnet-5
# AGENT_MODEL_FRONTEND=anthropic/claude-sonnet-5
# AGENT_MODEL_BACKEND=anthropic/claude-sonnet-5
# AGENT_MODEL_REVIEWER=anthropic/claude-opus-5

# Provider API keys. Only the one matching the provider prefix(es) above is required.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=

# Path to the bread-sheet repo checkout this orchestrator operates on.
# Defaults to the parent of this directory (agent-team/../) if unset.
# REPO_ROOT=/home/jano/IdeaProjects/bread-sheet
