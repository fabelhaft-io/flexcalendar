# Model for each agent role, as a Mastra model-router id ("<provider>/<model-id>").
# AGENT_MODEL is the fallback for both roles. No defaults are baked in: config.ts fails fast if
# a role's model or the matching provider key isn't set.
#
# Mind the exact model id the provider lists today. DeepSeek's API listed `deepseek-flash` and
# `deepseek-v4-pro` on 2026-10-04; a wrong id within a valid provider only shows up as a live
# API error.
AGENT_MODEL=deepseek/deepseek-flash
# AGENT_MODEL_IMPLEMENTER=deepseek/deepseek-flash
# AGENT_MODEL_REVIEWER=deepseek/deepseek-v4-pro   # only used with --with-reviewer

# Provider API keys. Only the one matching the provider prefix(es) above is required.
# These are read by the coordinator process only; agent shell commands never see them.
DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Path to the calendar-flex checkout this orchestrator operates on.
# Defaults to the parent of this directory (agent-team/../) if unset.
# REPO_ROOT=/home/jano/IdeaProjects/calendar-flex

# Branch the requirement worktrees are cut from. Defaults to main. A requirement that builds on
# an unmerged branch is cut from that branch instead.
# BASE_BRANCH=main

# Most model turns one implementer or reviewer run may take: an integer from 1 to 1000, default
# 300. A run that reaches it ends without a handoff (its code is still committed and reviewable).
# AGENT_MAX_STEPS=300
